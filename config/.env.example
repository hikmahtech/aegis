# AEGIS bootstrap config — copy to config/.env and fill in.
#
#   cp config/.env.example config/.env
#
# This file holds ONLY the handful of values needed to boot. Everything else
# (LLM provider + key, Slack/Todoist/GitHub/Sentry/… integrations, infra
# hosts, coding agents) is configured from the admin panel and stored
# encrypted in the DB — do NOT list those here. All keys take the AEGIS_
# prefix (pydantic-settings). Never commit the real config/.env.

# --- Required: admin login for the panel at http://localhost:8080 ---
# admin/admin is rejected at boot — pick your own.
AEGIS_ADMIN_USERNAME=admin
AEGIS_ADMIN_PASSWORD=change-me

# --- Strongly recommended: app secret ---
# Fernet key that encrypts integration secrets stored in the DB. Unset = those
# secrets are stored in plaintext. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGIS_SECRET_KEY=

# --- Optional: local Postgres password (compose interpolation) ---
# Read by docker-compose.yml for the bundled Postgres; defaults to aegis_dev.
# This one lives in a ROOT-level .env (not this file) or your shell env.
# POSTGRES_PASSWORD=aegis_dev

# --- Optional: LLM backend env fallback ---
# Preferred path is the admin "Models & Providers" page. These are only used
# until you configure a provider there (or for local dev).
# AEGIS_LITELLM_URL=http://litellm:4000
# AEGIS_LITELLM_API_KEY=

# --- Optional: Slack (only with `docker compose --profile slack up`) ---
# Preferred path is admin → Configure → Slack (encrypted in DB). Env is dev fallback.
# AEGIS_CHANNEL=slack
# AEGIS_SLACK_BOT_TOKEN=
# AEGIS_SLACK_APP_TOKEN=

# --- Optional: infra-alert cluster label ---
# Alerts whose Prometheus/Alertmanager `cluster` label equals this are routed
# straight to infra-gitops (skipping the LLM repo-match). Blank ⇒ off; alerts
# are still classified as infra by alertname. Set to your own cluster label.
# AEGIS_INFRA_CLUSTER=

# --- Optional: script-host k8s contexts (ArgoCD chat tools + Live Inspector) ---
# Comma-separated k8s "context" names that exist on the remote script host
# (the host scripts/infra/*.sh + the argocd CLI run on). Blank ⇒ none; k8s
# pod/deployment/log tools then resolve only via registered kind=k8s infra
# entries (by slug), and the ArgoCD tools have no valid context until set.
# AEGIS_SCRIPT_HOST_K8S_CONTEXTS=

# --- Optional: Money Hygiene (Maou) currency ---
# Currency all Money-Hygiene charges normalize to; drives the digest symbol.
# Defaults to INR (the author's own setup). Set matching fx rates below if
# you change this.
# AEGIS_HOME_CURRENCY=
# Deterministic bank-alert guard — comma-separated bank alert-sender domains
# whose mail must never be minted into a recurring charge (belt-and-suspenders
# behind the LLM prompt hardening). Blank ⇒ guard is a no-op.
# AEGIS_BANK_ALERT_SENDERS=
# Fallback FX rates (foreign currency -> home currency) as a JSON object,
# e.g. {"USD": 84.5, "EUR": 92.0}. Defaults to the built-in INR rates.
# AEGIS_MONEY_HYGIENE_FX_RATES=

# --- Optional: the books (Maou's hledger journal) ---
# Preferred path is admin → Integrations → Books (encrypted in DB); these are
# the first-boot fallback. Nothing here does anything until Money Hygiene is on
# (Integrations → Features). Full how-to: docs/infrastructure.md.
# Working copy inside the container. Env-only — core and worker must mount the
# same path, so it is not an admin-page setting.
# AEGIS_BOOKS_PATH=/app/config/books
# The books repo, SSH form. Blank ⇒ posting disabled: money mail is still
# parsed and indexed, never written to a journal.
# AEGIS_BOOKS_REPO_URL=git@github.com:org/books.git
# Private ed25519 deploy key with write access on that repo, PEM or its base64.
# Written to <gmail_token_dir>/books_deploy_key with mode 0600 at boot and never
# logged. Never commit a real key.
# AEGIS_BOOKS_DEPLOY_KEY=
# Comma-separated mailbox labels whose money is not yours. Blank ⇒ none.
# AEGIS_BOOKS_IGNORED_MAILBOXES=
# label=personal|hikmah,... — which set of books a mailbox's money belongs to.
# An unlisted mailbox is personal.
# AEGIS_BOOKS_MAILBOX_ENTITIES=
# personal=<todoist project id>,hikmah=<id> — where dated bills and failed
# payments are captured. Blank ⇒ the Inbox.
# AEGIS_BOOKS_TODOIST_PROJECTS=

# --- Optional: memory consolidation apply mode (DESTRUCTIVE — read this) ---
# The nightly MemoryReflectionFlow lets an LLM propose ADD/UPDATE/DELETE ops
# over agent_memory — the user's own accumulated corrections. It PLANS and
# LOGS by default and writes nothing.
#
# Turning writes on takes BOTH of:
#   1. this variable set to true on the WORKER, and
#   2. `dry_run: false` in the memory-reflection-nightly row's config, set on
#      /admin/flows (activities.config is DB-owned — editing
#      config/seed/activities.yaml does NOT reach a running deployment).
# Either one missing ⇒ the pass logs `status=apply_disabled` and writes
# nothing. Unset this and restart the worker to kill writes fleet-wide.
#
# Before enabling: read a week of proposals at
#   GET /api/admin/agents/<agent>/memory/ops
# DELETE is a soft retire (agent_memory.superseded_at), so a bad night is
# undone with:
#   UPDATE agent_memory SET superseded_at = NULL, superseded_by = NULL
#   WHERE agent_id = '<agent>' AND superseded_at > now() - interval '1 day';
# AEGIS_MEMORY_CONSOLIDATION_APPLY_ENABLED=false

# --- Optional: admin SPA dist path override ---
# Where Core looks for the built admin-panel frontend (index.html) when the
# Docker/local-dev default locations don't apply. Blank ⇒ Core tries
# /app/admin-panel/frontend/dist, then the repo-relative path, then CWD.
# AEGIS_ADMIN_DIST_DIR=

# --- Optional: personality starter-files dir override ---
# Where personalities/<agent>/*.md starter files are imported from on first
# boot (DB rows win afterwards). Blank ⇒ repo's personalities/ dir, then
# /app/personalities in the container.
# AEGIS_PERSONALITY_DIR=

# --- Optional: OpenTelemetry ---
# Opt-in tracing/logging correlation across core/worker/comms; no-op unless
# explicitly enabled.
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=aegis-core

# --- Optional: MCP client (external tool servers) ---
# Off by default; also needs the "MCP client (external tool servers)" toggle
# under Integrations -> Features (or AEGIS_MCP_ENABLED=true). Off => no MCP
# server is contacted at all, whatever AEGIS_MCP_SERVERS says.
# Only the streamable-http transport is supported: a "stdio" entry is REJECTED
# (it would spawn a local process). Declaring auth_token but leaving it blank
# rejects that server rather than connecting anonymously — omit the key for an
# unauthenticated server. timeout_s is the TOTAL budget per call (max 120);
# max_response_bytes caps the response (max 8000000). See docs/development.md.
# Enabling this does NOT let any agent call these tools (that gating is B9).
# AEGIS_MCP_ENABLED=true
# AEGIS_MCP_SERVERS={"docs": {"transport": "streamable-http", "url": "https://mcp.example.com/mcp", "auth_token": "...", "timeout_s": 30}}

# --- Optional: MCP server (serve AEGIS's own tools to external harnesses) ---
# Off by default. Exposes POST /api/mcp-server/{agent_id} (repo-standard auth,
# tools gated to that agent's tool_set) so claude/kimi CLI runs or Claude
# Desktop can mount AEGIS's tools. Independent of AEGIS_MCP_ENABLED above.
# AEGIS_MCP_SERVER_ENABLED=true
# Core's base URL AS REACHABLE FROM THE CODING HOST (a LAN address — not the
# browser-facing one, which is usually behind a proxy the CLI can't traverse).
# Set it — plus a key, either AEGIS_API_KEY or one generated in the admin UI —
# to mount AEGIS's tools into claude-engine agent runs; URL or key missing =>
# runs launch with no AEGIS tools. An infra coding.mcp_server_url overrides
# this. See docs/development.md (Agent runs).
# AEGIS_MCP_SERVER_EXTERNAL_URL=http://10.0.0.5:8080
# AEGIS_AUTH_DISABLED=true + AEGIS_MCP_SERVER_ENABLED=true is REFUSED (403 on
# every method): auth_disabled makes verify_auth a no-op, which is only safe
# behind an authenticating proxy, and this endpoint is mounted at a LAN URL
# that deliberately bypasses that proxy — the combination would serve every
# agent's tools (restart_service, run_infra_script, money/GTD writes) with no
# credential at all. Prefer unsetting AEGIS_AUTH_DISABLED and setting a key.
# Only if Core is genuinely unreachable except from trusted hosts:
# AEGIS_MCP_SERVER_ALLOW_UNAUTHENTICATED=true
